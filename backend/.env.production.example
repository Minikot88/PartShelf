APP_NAME=PartShelf
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://app.example.com
LOG_CHANNEL=stderr
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=verify-full
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_COOKIE=partshelf_session
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=app.example.com
CACHE_STORE=database
CACHE_PREFIX=partshelf_production
FILE_TRANSPORT=object
PRODUCT_IMAGE_DISK=r2
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=false
# Set only the verified ingress proxy CIDRs/addresses; do not guess a wildcard.
TRUSTED_PROXIES=
