{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": false },
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "installCommand": "npm ci",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "backend": { "root": "backend", "runtime": "container", "entrypoint": "Dockerfile.production" }
  },
  "rewrites": [
    { "source": "/", "destination": { "service": "frontend", "path": "/index.html" } },
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/sanctum/:path*", "destination": { "service": "backend" } },
    { "source": "/:path*", "destination": { "service": "frontend" } }
  ],
  "headers": [
    { "source": "/api/:path*", "headers": [{ "key": "Cache-Control", "value": "private, no-store" }] },
    { "source": "/sanctum/:path*", "headers": [{ "key": "Cache-Control", "value": "private, no-store" }] },
    { "source": "/:path*", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "same-origin" }] }
  ]
}
